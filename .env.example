APP_NAME="HardwareHub IMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / MariaDB (XAMPP defaults). For a zero-setup demo you can use
# DB_CONNECTION=sqlite instead and delete the other DB_ lines.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hardware_ims
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@hardwarehub.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Store settings (see config/store.php) ---
STORE_EMAIL=hello@hardwarehub.test
STORE_PHONE="(02) 8123 4567"
STORE_ADDRESS="123 Rizal Avenue, Quezon City, Metro Manila"
STORE_HOURS="Mon–Sat, 8:00 AM – 6:00 PM"
STORE_SHIPPING_FEE=45
STORE_FREE_SHIPPING_THRESHOLD=5000
STORE_GCASH_NAME="HardwareHub Trading"
STORE_GCASH_NUMBER="0917 123 4567"
STORE_BANK_NAME="BDO Unibank"
STORE_BANK_ACCOUNT_NAME="HardwareHub Trading"
STORE_BANK_ACCOUNT_NUMBER="0012 3456 7890"
