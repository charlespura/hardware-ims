# ---------------------------------------------------------------------------
# This folder is the Laravel *project root*, not the web root.
#
# If you cloned it inside XAMPP's htdocs, Apache would otherwise serve files
# like .env (database password, APP_KEY) to anyone on your network.
# Run the app with `composer run dev` / `php artisan serve` instead, or point
# an Apache virtual host's DocumentRoot at the /public folder (see README).
# ---------------------------------------------------------------------------
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
